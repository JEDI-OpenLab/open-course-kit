---
const { version = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = 2026;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <div class="footer-brand">Open Course Kit</div>
        <div class="footer-tag">Une ressource JEDI-OpenLab.</div>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <h4>Le kit</h4>
          <ul>
            <li><a href={`${base}licences`}>Licences</a></li>
            <li><a href={`${base}preparer`}>Préparer</a></li>
            <li><a href={`${base}modeles`}>Modèles</a></li>
            <li><a href={`${base}a-propos`}>À propos</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Ouvert</h4>
          <ul>
            <li><a href="https://jedi-openlab.github.io/jedi/" target="_blank" rel="noopener">JEDI-OpenLab</a></li>
            <li><a href="https://github.com/JEDI-OpenLab/open-course-kit" target="_blank" rel="noopener">GitHub</a></li>
            <li><a href="https://creativecommons.org/licenses/by/4.0/deed.fr" target="_blank" rel="noopener">CC BY 4.0</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-fine">
      <span>© {year} JEDI-OpenLab</span>
      <span class="version">{version}</span>
    </div>
  </div>
</footer>
